# ── Server ──────────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 3001 in dev, 5000 in production)
PORT=5000

# Node environment
NODE_ENV=production

# Path to the SQLite database file (default: ./data/barber.db)
# On Replit, the project root persists so the default path is fine.
# DB_PATH=/data/barber.db

# ── Future / Optional ────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# (Set this to migrate from SQLite to PostgreSQL — not implemented in v1.0)
