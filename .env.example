# ── Server ──────────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 3002 in dev, 5000 in production)
PORT=5000

# Node environment
NODE_ENV=production

# ── PostgreSQL (REQUIRED) ─────────────────────────────────────────────────────
# On Replit: injected automatically when you add the PostgreSQL addon (Secrets tab)
# Locally:   create a local Postgres DB and set this URL
DATABASE_URL=postgresql://user:password@localhost:5432/barber
